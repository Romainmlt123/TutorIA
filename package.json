{
  "name": "tutoria",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "expo start --go",
    "android": "expo start --go --android",
    "ios": "expo start --go --ios",
    "web": "expo start --web",
    "tokens": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-tokens.ts",
    "avatar:model": "blender -b -P tools/avatar-3d/avatar.py && npx -y @gltf-transform/cli@4.5.1 quantize assets/avatar/avatar.glb assets/avatar/avatar.glb",
    "explorer:models": "blender -b -P tools/explorer-3d/island_maths.py && npx -y @gltf-transform/cli@4.5.1 quantize assets/explorer/models/island-maths-3d.glb assets/explorer/models/island-maths-3d.glb && EXPLORER_FALLBACK=$PWD/assets/explorer/images/island-maths.webp blender -b -P tools/explorer-3d/island_maths.py && blender -b -P tools/explorer-3d/wood_panel.py && blender -b -P tools/explorer-3d/islet_algo.py && npx -y @gltf-transform/cli@4.5.1 quantize assets/explorer/models/islet-algo.glb assets/explorer/models/islet-algo.glb && blender -b -P tools/explorer-3d/strip_kit.py && npx -y @gltf-transform/cli@4.5.1 quantize assets/explorer/models/strip-kit.glb assets/explorer/models/strip-kit.glb && blender -b -P tools/explorer-3d/strip_monuments.py && npx -y @gltf-transform/cli@4.5.1 quantize assets/explorer/models/strip-nombres.glb assets/explorer/models/strip-nombres.glb && EXPLORER_DROP=boulier,octaedre EXPLORER_REGION_SCALE=6 blender -b -P tools/explorer-3d/region_map.py && npx -y @gltf-transform/cli@4.5.1 quantize assets/explorer/models/region-maths-nombres.glb assets/explorer/models/region-maths-nombres.glb",
    "lint": "expo lint",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "check": "npm run lint && npm run typecheck && npm test",
    "prepare": "husky",
    "start:tunnel": "expo start --go --tunnel",
    "start:dev": "expo start --dev-client --tunnel",
    "build:dev": "npx eas-cli@latest build --profile development --platform android",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --level warning",
    "db:new": "supabase migration new",
    "db:types": "supabase gen types typescript --local --schema public > src/services/db/database.types.ts && prettier --write src/services/db/database.types.ts",
    "db:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env scripts/seed.ts",
    "web:local": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/local-supabase.ts",
    "monitor": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env monitor/main.ts",
    "update:preview": "npx eas-cli@latest update --channel preview --environment preview"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^15.0.2",
    "@mathjax/src": "^4.1.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-three/fiber": "^9.8.1",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.0",
    "expo": "~57.0.25",
    "expo-asset": "~57.0.18",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-gl": "~57.0.2",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.23",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.23",
    "openai": "^7.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webrtc": "^124.0.8",
    "react-native-worklets": "0.10.1",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "supabase": "^2.118.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-native-svg)"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "testTimeout": 20000
  },
  "lint-staged": {
    "*.{ts,tsx,js}": "eslint --fix",
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-webrtc"
        ]
      }
    }
  },
  "engines": {
    "node": ">=24.13.0",
    "npm": ">=11"
  }
}
