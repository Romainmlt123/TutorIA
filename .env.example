# Copier ce fichier en .env et renseigner les valeurs (ne jamais versionner .env).
# En local, `npm run web:local` remplace les variables Supabase par celles de Supabase local.

# --- Serveur intermédiaire uniquement (server/env.ts) : jamais embarqué dans l'app ---
# Clé d'API OpenAI
OPENAI_API_KEY=
# Modèle de la discussion écrite
OPENAI_TEXT_MODEL=
# Modèle de la conversation vocale en temps réel
OPENAI_VOCAL_MODEL=
# Clé secrète Supabase (sb_secret_…) : contourne la RLS, ne sort jamais du serveur
SUPABASE_SECRET_KEY=
# Clé de hachage des codes de liaison : 32 octets aléatoires en hexadécimal (openssl rand -hex 32)
LINK_CODE_PEPPER=

# --- Public (préfixe EXPO_PUBLIC_ : lisible dans l'app, aucun secret) ---
# Projet Supabase (ex. https://<ref>.supabase.co), lu aussi par le serveur
EXPO_PUBLIC_SUPABASE_URL=
# Clé publiable Supabase (sb_publishable_…) : publique par nature, la sécurité repose sur la RLS
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Facultatif. Données : supabase (par défaut si le projet est renseigné) ou mock (comptes simulés, hors ligne)
EXPO_PUBLIC_BACKEND=
# Facultatif. Tuteur : live (par défaut, vrai tuteur via le serveur) ou mock (simulé, hors ligne)
EXPO_PUBLIC_TUTOR_MODE=
# Facultatif. Adresse du serveur intermédiaire pour les builds natifs de production (ex. https://tutoria.expo.app)
EXPO_PUBLIC_API_BASE_URL=

# --- Script de seed uniquement (scripts/seed.ts) ---
# Mot de passe des comptes de démonstration (obligatoire avec --remote ; Tutoria2026 en local par défaut)
SEED_DEMO_PASSWORD=
# Ref du projet en ligne autorisé à recevoir le seed (--remote), par sécurité
SEED_ALLOW_PROJECT=
